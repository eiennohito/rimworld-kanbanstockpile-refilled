<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><WorkspaceRoot Condition="'$(WorkspaceRoot)' == ''">$(MSBuildThisFileDirectory)../../..</WorkspaceRoot></PropertyGroup>
  <Import Project="$(WorkspaceRoot)/tools/dotnet/RimWorld17.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>KanbanStockpile</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableTargetingPackDownload>false</EnableTargetingPackDownload>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">$(HARMONY_DIR)</HarmonyDir>
  </PropertyGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RimWorldDir)/Assembly-CSharp.dll')" Text="Set RimWorldDir (or RIMWORLD_DIR) to the RimWorld 1.7 installation directory." />
    <Error Condition="!Exists('$(HarmonyDir)/0Harmony.dll')" Text="Set HarmonyDir (or HARMONY_DIR) to Harmony's 1.7/Assemblies directory." />
  </Target>
</Project>
